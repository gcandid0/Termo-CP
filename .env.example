# ==============================================================================
# TERMO-CP - Exemplo de Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores para o seu ambiente:
# cp .env.example .env

# Chave secreta do Django (Gere uma chave longa e aleatória para produção)
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-gerada-para-producao

# Modo de depuração (Defina como True apenas em desenvolvimento local; False em produção)
DEBUG=True

# Hosts autorizados (separados por vírgula no servidor de produção)
# ALLOWED_HOSTS=127.0.0.1,localhost,gcandid0.pythonanywhere.com

# Segurança em produção
ALLOWED_HOSTS=gcandid0.pythonanywhere.com
ADMIN_URL=admin/
SECURE_SSL_REDIRECT=True
