# ==============================================================================
# TERMO-CP - .gitignore
# ==============================================================================

# Ambientes virtuais
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Bytecode e caches compilados do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Banco de dados local
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Arquivos estáticos coletados e uploads de mídia
staticfiles/
media/
local_settings.py

# Arquivos temporários e compactados
*.zip
*.tar.gz
*.rar
*.7z
*.log

# Caches de testes e cobertura
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
